---
import { Icon } from 'astro-icon/components';
import type { Brands as Props } from '~/types';

import Image from '~/components/common/Image.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  icons = [],
  images = [],
  variant = 'grid',
  grayscale = false,
  boxed = true,
  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

// `grayscale` renders the logos monochrome (white on dark) and reveals their
// colours on hover; `boxed` keeps the light card behind each logo (the
// original look). The marquee duplicates the row so the loop is seamless and
// stops for people who prefer reduced motion.
const logoClass = [
  'max-h-12 transition',
  grayscale
    ? 'grayscale opacity-70 hover:grayscale-0 hover:opacity-100 dark:brightness-0 dark:invert dark:hover:brightness-100 dark:hover:invert-0'
    : '',
].join(' ');
const boxClass = boxed ? 'py-1 px-3 rounded-md bg-white/90 dark:bg-gray-200' : 'py-1 px-3';
const isMarquee = variant === 'marquee';
const duration = `${Math.max(20, (icons.length + images.length) * 4)}s`;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} classes={classes?.headline as Record<string, string>} />

  <div
    class:list={[
      isMarquee
        ? 'aw-marquee overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]'
        : 'flex flex-wrap justify-center gap-x-6 sm:gap-x-12 lg:gap-x-24',
    ]}
    style={isMarquee ? `--aw-marquee-duration: ${duration}` : undefined}
  >
    {
      [0, ...(isMarquee ? [1] : [])].map((copy) => (
        <div
          class:list={[
            isMarquee ? 'aw-marquee-track flex shrink-0 items-center gap-x-12 lg:gap-x-20 pr-12 lg:pr-20' : 'contents',
          ]}
          aria-hidden={copy === 1 ? 'true' : undefined}
        >
          {icons &&
            icons.map((icon) => (
              <Icon name={icon} class:list={['py-3 lg:py-5 w-12 h-auto mx-auto sm:mx-0 text-gray-500', logoClass]} />
            ))}
          {images &&
            images.map(
              (image) =>
                image.src &&
                (image.href ? (
                  <a
                    href={image.href}
                    class:list={['flex justify-center my-2 lg:my-4', boxClass]}
                    target="_blank"
                    rel="noopener noreferrer"
                    tabindex={copy === 1 ? -1 : undefined}
                  >
                    <Image
                      src={image.src}
                      alt={image.alt || ''}
                      class={logoClass}
                      width={120}
                      height={48}
                      format="webp"
                    />
                  </a>
                ) : (
                  <div class:list={['flex justify-center my-2 lg:my-4', boxClass]}>
                    <Image
                      src={image.src}
                      alt={image.alt || ''}
                      class={logoClass}
                      width={120}
                      height={48}
                      format="webp"
                    />
                  </div>
                ))
            )}
        </div>
      ))
    }
  </div>
</WidgetWrapper>

<style>
  .aw-marquee {
    display: flex;
  }
  .aw-marquee-track {
    animation: aw-marquee var(--aw-marquee-duration, 30s) linear infinite;
  }
  .aw-marquee:hover .aw-marquee-track {
    animation-play-state: paused;
  }
  @keyframes aw-marquee {
    to {
      transform: translateX(-100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .aw-marquee {
      flex-wrap: wrap;
      justify-content: center;
      mask-image: none;
    }
    .aw-marquee-track {
      animation: none;
      flex-shrink: 1;
      width: 100%;
      flex-wrap: wrap;
      justify-content: center;
      padding-right: 0;
    }
    .aw-marquee-track[aria-hidden='true'] {
      display: none;
    }
  }
</style>
