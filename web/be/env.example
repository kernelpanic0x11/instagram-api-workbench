# REA_EXECUTOR=fargate
# REA_WORKER_BUCKET=
# REA_ECS_CLUSTER=
# REA_ECS_TASK_DEFINITION=
# REA_ECS_SUBNETS=subnet-...
# REA_ECS_SECURITY_GROUPS=sg-...
