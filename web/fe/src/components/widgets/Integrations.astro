---
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { getColumnsClass } from '~/utils/utils';
import type { Integrations as Props } from '~/types';

// Grid of tools the product works with: a logo or brand icon, a name and
// an optional one-line description, each card optionally linked.

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  items = [],
  columns = 4,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

const columnsClass =
  columns === 5 ? 'sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5' : getColumnsClass(columns, 'sm:grid-cols-2');
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} classes={classes?.headline as Record<string, string>} />

  <ul class:list={['grid grid-cols-2 gap-4 md:gap-5 list-none', columnsClass]}>
    {
      items.map(({ name, description, icon, image, href }) => {
        const Card = href ? 'a' : 'div';
        return (
          <li class="intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
            <Card
              href={href}
              target={href ? '_blank' : undefined}
              rel={href ? 'noopener noreferrer' : undefined}
              class:list={[
                'flex h-full items-center gap-4 rounded-xl border border-gray-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900',
                href ? 'transition hover:border-primary/40 hover:shadow-md' : '',
              ]}
            >
              <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-gray-100 dark:bg-slate-800">
                {image ? (
                  typeof image === 'string' ? (
                    <Fragment set:html={image} />
                  ) : (
                    <Image
                      class="h-7 w-7 object-contain"
                      width={28}
                      height={28}
                      layout="fixed"
                      format="webp"
                      {...image}
                    />
                  )
                ) : (
                  icon && <Icon name={icon} class="h-7 w-7 text-heading" />
                )}
              </span>
              <span class="min-w-0">
                <span class="block font-semibold text-heading">{name}</span>
                {description && <span class="block truncate text-sm text-muted">{description}</span>}
              </span>
            </Card>
          </li>
        );
      })
    }
  </ul>
</WidgetWrapper>
