PORT=8787
HOST=127.0.0.1
PUBLIC_ORIGIN=http://127.0.0.1:8787
DATA_DIR=./data
FRONTEND_DIST=../fe/dist
AWS_PROFILE=admin
AWS_REGION=us-east-1
# Required: a tool-capable model or inference profile accessible in your account.
BEDROCK_MODEL_ID=
# Cognito managed login: passwords and verification stay with Cognito.
COGNITO_DOMAIN=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
REA_EXECUTOR=docker
REA_WORKER_IMAGE=rea-analysis:6.7.0
